#!/bin/sh /etc/rc.common
# procd service for OpenWrt based hosts. Install as /etc/init.d/bleproxyd.
# RutOS 7.x has a read-only root; /usr/local and /etc are the writable overlay.

START=99
STOP=10
USE_PROCD=1

PROG=/usr/local/bin/bleproxyd
CONFIG=/etc/bleproxyd.conf

start_service() {
	procd_open_instance
	procd_set_param command "$PROG" run -c "$CONFIG"
	procd_set_param file "$CONFIG"
	# Respawn forever, 5 s apart.
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
